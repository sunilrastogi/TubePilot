# Copy of this file is created as .env by setup.bat. Never commit .env.
# You can fill these in here or in the app's Settings tab. Leave unused ones blank.

# Required: YouTube Data API v3 key (channel stats, trends, video comparison)
YOUTUBE_API_KEY=

# Optional: Anthropic API key. Leave blank to use your Claude login via the `claude` CLI instead.
ANTHROPIC_API_KEY=

# Needed for thumbnail generation and the edit.py transcription helper
OPENAI_API_KEY=

# Needed only for publishing to YouTube (OAuth client of type "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Defaults
CHANNEL=
NICHE=

# Advanced (optional)
# CLAUDE_CLI_MODEL=sonnet
# OPENAI_IMAGE_MODEL=gpt-image-1
